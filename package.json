{
  "name": "telegram-ai-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Telegram <-> AI gateway dashboard for Vercel serverless deployment.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:seed:demo": "tsx src/lib/db/seed-demo.ts",
    "db:studio": "drizzle-kit studio",
    "gen:key": "node scripts/gen-key.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:audit": "node scripts/audit.mjs",
    "qa:shots": "node scripts/shoot.mjs",
    "qa:smoke": "node --import tsx --import ./scripts/register-stub.mjs scripts/smoke.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.9",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "next-themes": "^0.4.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "postcss": "^8.5.22"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.4": true,
    "unrs-resolver@1.12.2": true
  }
}
