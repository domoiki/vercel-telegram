# ---------------------------------------------------------------------------
# Infrastructure secrets only.
# Everything else (bot token, chat IDs, AI providers, API keys, model settings)
# is configured from the dashboard and stored encrypted in Turso.
# ---------------------------------------------------------------------------

# Turso / libSQL connection
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# 32-byte key, hex or base64 encoded. Used to encrypt secrets at rest.
# Generate one with:  npm run gen:key   (or: openssl rand -hex 32)
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Public URL of this deployment. Only needed to register the Telegram webhook
# from the dashboard. Falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional lightweight guard for mutating admin API routes.
# When set, write requests must send the matching `x-admin-key` header.
# The dashboard prompts for it once and keeps it in sessionStorage only.
# Leave empty to disable (acceptable only on a private deployment / localhost).
ADMIN_API_KEY=

# Local development only: point at a local SQLite file instead of Turso.
# DATABASE_URL=file:./data/local.db
